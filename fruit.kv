#:import utils utils

<Root>:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: 0.953, 0.925, 0.851, 1  # paper
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: dp(96)
        padding: dp(16), dp(14)
        spacing: dp(2)
        canvas.before:
            Color:
                rgba: 0.184, 0.322, 0.2, 1  # forest
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "SORTIR"
            font_size: "26sp"
            bold: True
            color: 1, 1, 1, 1
            halign: "left"
            valign: "middle"
            text_size: self.size
        Label:
            text: "Klasifikasi Kualitas Buah - Machine Learning"
            font_size: "12sp"
            color: 0.9, 0.9, 0.85, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

    ScrollView:
        BoxLayout:
            orientation: "vertical"
            padding: dp(18)
            spacing: dp(14)
            size_hint_y: None
            height: self.minimum_height

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(240)
                canvas.before:
                    Color:
                        rgba: 0.984, 0.969, 0.918, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: 0.725, 0.482, 0.071, 1
                    Line:
                        rectangle: self.x, self.y, self.width, self.height
                        width: 1.4
                        dash_offset: 6
                        dash_length: 8

                Image:
                    id: preview_image
                    source: root.image_source
                    fit_mode: "contain"

            BoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(10)

                Button:
                    text: "Ambil Foto"
                    background_normal: ""
                    background_color: 0.184, 0.322, 0.2, 1
                    color: 1, 1, 1, 1
                    bold: True
                    on_release: root.take_photo()

                Button:
                    text: "Pilih Galeri"
                    background_normal: ""
                    background_color: 0.878, 0.635, 0.180, 1
                    color: 0.14, 0.12, 0.08, 1
                    bold: True
                    on_release: root.pick_from_gallery()

            Button:
                text: "KLASIFIKASIKAN"
                size_hint_y: None
                height: dp(52)
                background_normal: ""
                background_color: 0.71, 0.27, 0.11, 1
                color: 1, 1, 1, 1
                bold: True
                disabled: not root.has_image
                on_release: root.classify_image()

            BoxLayout:
                id: result_card
                orientation: "vertical"
                size_hint_y: None
                height: dp(260) if root.has_result else 0
                opacity: 1 if root.has_result else 0
                padding: dp(16)
                spacing: dp(8)
                canvas.before:
                    Color:
                        rgba: 0.984, 0.969, 0.918, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14]

                Label:
                    id: grade_label
                    text: root.grade_text
                    font_size: "22sp"
                    bold: True
                    color: root.grade_color
                    size_hint_y: None
                    height: dp(32)
                    halign: "left"
                    text_size: self.size

                Label:
                    text: root.score_text
                    font_size: "15sp"
                    color: 0.14, 0.12, 0.08, 1
                    size_hint_y: None
                    height: dp(24)
                    halign: "left"
                    text_size: self.size

                Label:
                    text: root.probs_text
                    font_size: "12.5sp"
                    color: 0.35, 0.32, 0.25, 1
                    size_hint_y: None
                    height: dp(70)
                    halign: "left"
                    valign: "top"
                    text_size: self.size

                Label:
                    text: root.note_text
                    font_size: "12sp"
                    color: 0.35, 0.32, 0.25, 1
                    size_hint_y: None
                    height: dp(60)
                    halign: "left"
                    valign: "top"
                    text_size: self.size

            Label:
                text: root.status_text
                font_size: "11.5sp"
                italic: True
                color: 0.4, 0.4, 0.35, 1
                size_hint_y: None
                height: dp(20)